{
  "tasks": {
    "test": "deno test --allow-read --allow-write --allow-env --allow-run",
    "check": "deno check",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "fmt": {
    "include": ["**/*.ts"]
  },
  "exclude": [
    ".claude",
    ".task-pipeline",
    ".task-prep",
    ".task-scout",
    "docs/metrics",
    "__pycache__"
  ]
}
